rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthed() {
      return request.auth != null && request.auth.token != null;
    }

    function isAdmin() {
      return isAuthed()
        && exists(/databases/$(database)/documents/meta/admins)
        && get(/databases/$(database)/documents/meta/admins).data.uids.hasAny([request.auth.uid]);
    }

    match /meta/banned {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /meta/auditLog/entries/{entryId} {
      allow read: if true;
      allow create: if isAuthed()
        && request.resource.data.keys().hasOnly(['action','target','by','ts','fp'])
        && request.resource.data.action is string
        && request.resource.data.action.size() <= 40
        && request.resource.data.target is string
        && request.resource.data.target.size() <= 100
        && request.resource.data.by is string
        && request.resource.data.by.size() <= 24
        && request.resource.data.ts is number
        && request.resource.data.fp is string
        && request.resource.data.fp.size() <= 100;
      allow update, delete: if false;
    }

    match /meta/admins {
      allow read: if isAuthed();
      allow write: if false;
    }

    match /counters/{counterId} {
      allow read: if true;
      allow create, update: if isAuthed()
        && exists(/databases/$(database)/documents/cards/$(counterId))
        && request.resource.data.size() == 1
        && request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count is number
        && request.resource.data.count >= 0
        && request.resource.data.count <= 1000000000;
      allow delete: if false;
    }

    match /comments/{cardId}/items/{cid} {
      allow read: if true;
      allow create: if isAuthed()
        && request.resource.data.keys().hasOnly(['name','text','ts'])
        && request.resource.data.name is string
        && request.resource.data.text is string
        && request.resource.data.ts is number
        && request.resource.data.ts > 0
        && request.resource.data.ts <= request.time.toMillis()
        && request.resource.data.name.size() <= 24
        && request.resource.data.text.size() <= 280;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /requests/{reqId} {
      allow read: if isAdmin();
      allow create: if isAuthed()
        && request.resource.data.keys().hasOnly(['name','text','ts'])
        && request.resource.data.name is string
        && request.resource.data.text is string
        && request.resource.data.ts is number
        && request.resource.data.ts > 0
        && request.resource.data.ts <= request.time.toMillis()
        && request.resource.data.name.size() <= 24
        && request.resource.data.text.size() <= 280;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /cards/{cardId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
