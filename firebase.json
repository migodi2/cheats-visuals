{
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "firestore.rules", ".firebaserc", "firebase-debug.log", "*.md", "downloads/**", "downloads", ".git/**", ".git", ".firebase/**", "functions/**", "functions", "node_modules/**", "*.log"],
    "rewrites": [
      { "source": "**", "destination": "/index.html" }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "name": "X-Content-Type-Options", "value": "nosniff" },
          { "name": "X-Frame-Options", "value": "DENY" },
          { "name": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "name": "Cache-Control", "value": "no-cache" }
        ]
      }
    ]
  }
}
